AI_COMPANY_FOLDER_NAME=AI_COMPANY
AI_COMPANY_DAILY_BRIEF=Daily_Brief.md
AI_COMPANY_CHARACTER=MIKU

# 外部公開Dashboard
# Renderなどに公開する場合は必ず設定
# DASHBOARD_PASSWORD=
# AI_COMPANY_NON_INTERACTIVE=1

# OAuth認証を使う場合
GOOGLE_OAUTH_CLIENT_SECRET=.secrets/client_secret.json
GOOGLE_OAUTH_TOKEN=.secrets/google_token.json

# クラウド環境でOAuth tokenをファイル配置できない場合
# 値はJSON全体を1行で設定する。Drive/Search Console/GA4は必要なscopeごとに分ける。
# GOOGLE_DRIVE_OAUTH_TOKEN_JSON={}
# GOOGLE_SEARCH_CONSOLE_TOKEN_JSON={}
# GOOGLE_GA4_TOKEN_JSON={}

# base64で渡す場合
# GOOGLE_DRIVE_OAUTH_TOKEN_BASE64=
# GOOGLE_SEARCH_CONSOLE_TOKEN_BASE64=
# GOOGLE_GA4_TOKEN_BASE64=

# サービスアカウントを使う場合
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON={}
# GOOGLE_APPLICATION_CREDENTIALS_BASE64=

# 既存のAI_COMPANY DriveフォルダIDが分かる場合
# AI_COMPANY_DRIVE_ROOT_ID=

# P003 WordPress解析対象
# P003_WORDPRESS_URL=https://example.com

# P004 アダルト事業部 WordPress解析対象
# 未設定の場合は P003_WORDPRESS_URL を使用
# P004_WORDPRESS_URL=https://example.com

# Google Search Console KPI取得
# SEARCH_CONSOLE_SITE_URL=https://example.com/
# GOOGLE_SEARCH_CONSOLE_SITE_URL=https://example.com/
# GOOGLE_SEARCH_CONSOLE_TOKEN=.secrets/search_console_token.json
# GOOGLE_SEARCH_CONSOLE_START_DATE=2026-06-01
# GOOGLE_SEARCH_CONSOLE_END_DATE=2026-06-30

# Google Analytics 4 KPI取得
# GA4_PROPERTY_ID=123456789
# GOOGLE_ANALYTICS_PROPERTY_ID=123456789
# GOOGLE_GA4_TOKEN=.secrets/ga4_token.json
# GOOGLE_GA4_START_DATE=2026-06-01
# GOOGLE_GA4_END_DATE=2026-06-30

# 画像EXIF削除
# GitHub版EXIF削除アプリを使う場合、実行コマンドを設定する。
# {path} は対象ファイルパスに置換される。
# EXIF_CLEANER_COMMAND=C:\Tools\exif-cleaner\exif-cleaner.exe "{path}"

# Google Drive同期フォルダを監視して、画像投入時に自動EXIF削除する場合
# GOOGLE_DRIVE_SYNC_ROOT=G:\マイドライブ\AI_COMPANY
# EXIF_WATCH_INTERVAL_SECONDS=10
# EXIF_WATCH_STABLE_SECONDS=5
